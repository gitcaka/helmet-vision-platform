# Flask 后端
HELMET_HOST=0.0.0.0
HELMET_PORT=5000
# 留空时每次启动会生成临时密钥；正式使用应填写持久随机密钥。
HELMET_SECRET_KEY=
HELMET_CORS_ORIGINS=http://localhost:3000
HELMET_SESSION_COOKIE_SAMESITE=Lax
HELMET_SESSION_COOKIE_SECURE=false
HELMET_SESSION_HOURS=8
HELMET_LOGIN_MAX_ATTEMPTS=5
HELMET_LOGIN_WINDOW_SECONDS=300
HELMET_DATA_RECONCILE_INTERVAL=60

# SQLite；留空时默认使用项目 data/helmet.db
# HELMET_DATABASE_PATH=E:\work\helmet-vision-platform\backend\data\helmet.db

# 检测程序写入接口必须携带同值的 X-API-Token；留空时写入接口关闭。
HELMET_INGEST_API_TOKEN=

# 视频流
HELMET_RTSP_URL=rtsp://localhost:8554/output
HELMET_VIDEO_FRAME_RATE=12
HELMET_VIDEO_JPEG_QUALITY=80
HELMET_VIDEO_OPEN_TIMEOUT_MS=3000
HELMET_VIDEO_READ_TIMEOUT_MS=3000
HELMET_VIDEO_RECONNECT_INITIAL=0.5
HELMET_VIDEO_RECONNECT_MAX=10
HELMET_MEDIAMTX_PATH=E:\work\mediamtx_v1.8.0_windows_amd64\mediamtx.exe
HELMET_START_MEDIAMTX=false

# PaddleDetection 是独立环境，不使用 py13 运行
HELMET_CONDA_EXE=D:\software\miniconda\Scripts\conda.exe
HELMET_PADDLE_ENV_NAME=PaddleDetection
HELMET_PADDLE_INFER_SCRIPT=E:\work\PaddleDetection\deploy\python\infer.py
HELMET_PADDLE_MODEL_DIR=E:\work\PaddleDetection\inference_model\ppyoloe_plus_crn_l_80e_coco
HELMET_PADDLE_DEVICE=gpu
HELMET_PADDLE_PUSH_URL=rtsp://localhost:8554/
HELMET_CAMERA_ID=0
HELMET_START_DETECT=false

# init_db.py 可读取这两个值；正式使用时不要把真实密码提交到 Git。
HELMET_ADMIN_USERNAME=admin
HELMET_ADMIN_PASSWORD=
